<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsUraPlugin>true</IsUraPlugin>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**</DefaultItemExcludes>
    <Version>2026.10.31</Version>
    <PluginInternalName>FestaScenarioAnalyzer</PluginInternalName>
    <PluginDisplayName>骏大祭分析</PluginDisplayName>
    <PluginAuthor>UmamusumeResponseAnalyzer</PluginAuthor>
    <PluginDescription>解析骏大祭回合训练信息</PluginDescription>
    <PluginRepositoryUrl>https://github.com/URA-Plugins/FestaScenarioAnalyzer</PluginRepositoryUrl>
    <PluginChangelog>首次发布骏大祭训练分析与内存历史浏览插件。</PluginChangelog>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FestaScenarioAnalyzerSmoke" />
    <Compile Remove="tests\**\*.cs" />
    <PackageReference Include="UmamusumeResponseAnalyzer" Version="*" PrivateAssets="all" />
  </ItemGroup>
</Project>
